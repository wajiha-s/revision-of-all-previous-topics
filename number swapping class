#include<iostream>
using namespace std;
class NumberSwapper
{
private:
    int a;
    int b;

public:
    void setData(int x, int y)
    {
        a = x;
        b = y;
    }
    void display()
    {
        cout << "A = " << a << endl;
        cout << "B = " << b << endl;
    }
    void swapNumbers(int x, int y)
    {
        int swap;
        swap = x;
        x = y;
        y = swap;

        cout << "swap function:" << endl;
        cout << "A = " << x << endl;
        cout << "B = " << y << endl;
    }
};
