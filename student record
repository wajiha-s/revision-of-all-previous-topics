#include <iostream>
using namespace std;

class StudentRecord
{
private:
    int rollNumber;
    int marks1;
    int marks2;

public:
    void setRollNumber(int r)
    {
        rollNumber = r;
    }

    void setMarks1(int m1)
    {
        marks1 = m1;
    }

    void setMarks2(int m2)
    {
        marks2 = m2;
    }
    int getRollNumber()
    {
        return rollNumber;
    }

    int getMarks1()
    {
        return marks1;
    }

    int getMarks2()
    {
        return marks2;
    }
    void display()
    {
        cout << "Roll Number: " << rollNumber << endl;
        cout << "Marks 1: " << marks1 << endl;
        cout << "Marks 2: " << marks2 << endl;
    }
    int calculateTotal()
    {
        int total = marks1 + marks2;
        cout << "Total Marks: " << total << endl;
        return total;
    }
    void calculateGrade()
    {
        int total = marks1 + marks2;
        char grade;

        if(total >= 85)
            grade = 'A';
        else if(total >= 70)
            grade = 'B';
        else if(total >= 50)
            grade = 'C';
        else
            grade = 'F';

        cout << "Grade: " << grade << endl;
    }
};

int main()
{
    StudentRecord student;
    student.setRollNumber(101);
    student.setMarks1(40);
    student.setMarks2(45);

    student.display();
    student.calculateTotal();
    student.calculateGrade();

    return 0;
}
