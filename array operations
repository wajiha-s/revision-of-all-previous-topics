#include<iostream>
using namespace std;
class array_operation
{
private:
	int* arr;
	int size;
public:
	void userInput()
	{
		cout << "enter the size" << endl;
		cin >> size;
		arr = new int[size];
		cout << "enter size" << size << "elements" << endl;
		for (int i = 0; i < size; i++)
		{
			cin >> arr[i];
		}
	}
	int calculatesum()
	{
		int sum = 0;
		for (int i = 0; i < size; i++)
		{
			sum += arr[i];
		}
		return sum;
	}
	double CalculateAverage()
	{
		return (double)calculatesum() / size;

	}
	void display()
	{
		cout << " array element" << endl;
		for (int i = 0; i < size; i++)
		{
			cout << arr[i] << endl;
		}
	}
	~array_operation()
	{
		delete[]arr;
	}

};
int main()
{
	array_operation ao1;
	ao1.userInput();
	cout << "enter sum" << ao1.calculatesum() << endl;
	cout << "enter average" << ao1.CalculateAverage() << endl;
	ao1.display();
	return 0;
}
